// Задание 07
class CartComponent {
  constructor(eventBus) {
    this.eventBus = eventBus;
    this.items = [];
    this.boundHandler = this.handleItemAdded.bind(this);
    this.eventBus.on("ITEM_ADDED", this.boundHandler);
  }

  handleItemAdded(item) {
    this.items.push(item);
  }

  destroy() {
    this.eventBus.off("ITEM_ADDED", this.boundHandler);
  }
}

// Задание 08
useEffect(() => {
  const id = setInterval(() => {
    setSecondsLeft(prev => {
      if (prev <= 1) {
        clearInterval(id);
        return 0;
      }
      return prev - 1;
    });
  }, 1000);

  return () => clearInterval(id);
}, []);

// Задание 09
async function processOrderPayment(paymentData) {
  try {
    const token = await generatePaymentToken(paymentData);
    const result = await chargeCard(token);
    return [null, result];
  } catch (error) {
    return [error, null];
  }
}

async function onCheckoutClick() {
  const [error, result] = await processOrderPayment(data);

  if (error) {
    showErrorModal(error.message);
    return;
  }

  showSuccessModal(result);
}

// Задание 10
let cachedUser = null;
let userPromise = null;

async function getAuthenticatedUser() {
  if (cachedUser) return cachedUser;

  if (!userPromise) {
    userPromise = fetch("/api/me")
      .then(res => {
        if (!res.ok) throw new Error("Request failed");
        return res.json();
      })
      .then(user => {
        cachedUser = user;
        return user;
      })
      .finally(() => {
        userPromise = null;
      });
  }

  return userPromise;
}

// Задание 11
async function fetchWithRetry(url, maxRetries = 5, baseDelay = 500) {
  for (let attempt = 0; attempt <= maxRetries; attempt++) {
    try {
      const response = await fetch(url);

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }

      return await response.json();
    } catch (error) {
      if (attempt === maxRetries) throw error;

      const delay = baseDelay * 2 ** attempt;
      const jitter = Math.random() * delay * 0.5;

      await new Promise(resolve =>
        setTimeout(resolve, delay + jitter)
      );
    }
  }
}

