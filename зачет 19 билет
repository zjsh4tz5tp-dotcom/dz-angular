CREATE TABLE dim_product (
    product_key INT AUTO_INCREMENT PRIMARY KEY,
    product_name VARCHAR(100)
);

факты производства и OEE
CREATE TABLE fact_production (
    fact_id INT AUTO_INCREMENT PRIMARY KEY,
    machine_key INT,
    date_key INT,
    product_key INT,
    planned_time DECIMAL(10,2),
    operating_time DECIMAL(10,2),
    total_quantity INT,
    good_quantity INT,
    defective_quantity INT,
    FOREIGN KEY (machine_key) REFERENCES dim_machine(machine_key),
    FOREIGN KEY (date_key) REFERENCES dim_date(date_key),
    FOREIGN KEY (product_key) REFERENCES dim_product(product_key)
);

факты расхода сырья
CREATE TABLE fact_material_consumption (
    consumption_key INT AUTO_INCREMENT PRIMARY KEY,
    machine_key INT,
    date_key INT,
    material_name VARCHAR(100),
    quantity DECIMAL(12,3),
    FOREIGN KEY (machine_key) REFERENCES dim_machine(machine_key),
    FOREIGN KEY (date_key) REFERENCES dim_date(date_key)
);



 3. РАСЧЕТ OEE


SELECT
    m.machine_name,

    ROUND(
        SUM(f.operating_time) /
        NULLIF(SUM(f.planned_time), 0) * 100,
        2
    ) AS availability_percent,

    ROUND(
        SUM(f.good_quantity) /
        NULLIF(SUM(f.total_quantity), 0) * 100,
        2
    ) AS quality_percent,

    ROUND(
        (SUM(f.operating_time) /
        NULLIF(SUM(f.planned_time), 0)) *
        (SUM(f.good_quantity) /
        NULLIF(SUM(f.total_quantity), 0)) * 100,
        2
    ) AS OEE_percent

FROM fact_production f
JOIN dim_machine m
    ON f.machine_key = m.machine_key
GROUP BY m.machine_name;


4. KB

CREATE DATABASE production_kb;
USE production_kb;

данные датчиков станков
CREATE TABLE sensor_data (
    sensor_id INT AUTO_INCREMENT PRIMARY KEY,
    machine_id INT NOT NULL,
    sensor_type VARCHAR(50),
    sensor_value DECIMAL(10,3),
    measurement_time DATETIME NOT NULL
);
и стория неисправностей
CREATE TABLE failures (
    failure_id INT AUTO_INCREMENT PRIMARY KEY,
    machine_id INT NOT NULL,
    failure_type VARCHAR(100),
    failure_date DATETIME NOT NULL,
    repair_description TEXT,
    downtime_hours DECIMAL(10,2)
);

арогнозы неисправностей
CREATE TABLE maintenance_predictions (
    prediction_id INT AUTO_INCREMENT PRIMARY KEY,
    machine_id INT NOT NULL,
    prediction_date DATETIME NOT NULL,
    failure_probability DECIMAL(5,2),
    predicted_failure VARCHAR(100),
    recommendation TEXT
);

регламент обслуживания
CREATE TABLE maintenance_rules (
    rule_id INT AUTO_INCREMENT PRIMARY KEY,
    machine_type VARCHAR(50),
    condition_description TEXT,
    recommended_action TEXT,
    maintenance_interval_days INT
);



5.ПРЕДИКТИВНОЕ ОБСЛУЖИВАНИЕ


SELECT
    machine_id,
    AVG(sensor_value) AS avg_temperature,
    MAX(sensor_value) AS max_temperature
FROM sensor_data
WHERE sensor_type = 'Температура'
  AND measurement_time >= NOW() - INTERVAL 24 HOUR
GROUP BY machine_id
HAVING MAX(sensor_value) > 80;


