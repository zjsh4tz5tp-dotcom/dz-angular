
function createVNode(type, props, ...children) {
  const normalizedChildren =
    children.length === 0
      ? undefined
      : children.length === 1
        ? children[0]
        : children;
  return {
    type,
    props: {
      ...(props ?? {}),
      ...(children.length > 0
        ? { children: normalizedChildren }
        : {}),
    },
    key: props?.key ?? null,
  };
}

const vnode = createVNode(
  "div",
  { className: "container" },
  createVNode("h1", null, "Hello"),
  createVNode("p", null, "World")
);

console.log(vnode);
