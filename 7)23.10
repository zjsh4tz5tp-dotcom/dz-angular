26.
function wait(milliseconds) {
  return new Promise(resolve => {
    setTimeout(resolve, milliseconds);
  });
}

27.
async function loadDashboard() {
  const results = await Promise.allSettled([
    fetch("/api/users").then(response => {
      if (!response.ok) throw new Error("Users request failed");
      return response.json();
    }),
    fetch("/api/stats").then(response => {
      if (!response.ok) throw new Error("Stats request failed");
      return response.json();
    }),
    fetch("/api/notifications").then(response => {
      if (!response.ok) throw new Error("Notifications request failed");
      return response.json();
    })
  ]);

  const successData = [];
  const errors = [];

  results.forEach((result, index) => {
    if (result.status === "fulfilled") {
      successData.push(result.value);
    } else {
      errors.push({
        requestIndex: index,
        message: result.reason?.message ?? String(result.reason)
      });
    }
  });

  return {
    successData,
    errors
  };
}

28.
async function fetchWithTimeout(url, timeoutMs) {
  const controller = new AbortController();

  const timeoutId = setTimeout(() => {
    controller.abort();
  }, timeoutMs);

  try {
    return await fetch(url, {
      signal: controller.signal
    });
  } finally {
    clearTimeout(timeoutId);
  }
}

29.
async function retry(asyncFn, retries = 3, delayMs = 500) {
  let lastError;

  for (let attempt = 0; attempt <= retries; attempt++) {
    try {
      return await asyncFn();
    } catch (error) {
      lastError = error;

      if (attempt === retries) {
        throw lastError;
      }

      await wait(delayMs);
    }
  }

  throw lastError;
}

30.
class AsyncQueue {
  constructor() {
    this.queue = [];
    this.running = false;
  }

  enqueue(taskFn) {
    return new Promise((resolve, reject) => {
      this.queue.push({
        taskFn,
        resolve,
        reject
      });

      this.runNext();
    });
  }

  async runNext() {
    if (this.running || this.queue.length === 0) {
      return;
    }

    this.running = true;

    const { taskFn, resolve, reject } = this.queue.shift();

    try {
      const result = await taskFn();
      resolve(result);
    } catch (error) {
      reject(error);
    } finally {
      this.running = false;
      this.runNext();
    }
  }
}
