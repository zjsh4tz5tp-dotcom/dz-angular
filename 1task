// Задание 11
function deepFreeze(object) {
  if (object === null || typeof object !== 'object') return object;
  Object.freeze(object);
  Object.values(object).forEach(deepFreeze);
  return object;
}

// Задание 12
function createCounter(initialValue = 0, step = 1) {
  let value = initialValue;
  return {
    inc: () => value += step,
    dec: () => value -= step,
    reset: () => value = initialValue,
    get: () => value
  };
}

// Задание 13
function memoize(fn) {
  const cache = new Map();
  return (...args) => {
    const key = JSON.stringify(args);
    if (cache.has(key)) return cache.get(key);
    const result = fn(...args);
    cache.set(key, result);
    return result;
  };
}

// Задание 14
function createValidator(ruleName, param) {
  return value => {
    let isValid = true;
    let message = '';
    switch (ruleName) {
      case 'minLength':
        isValid = value.length >= param;
        message = isValid ? '' : `Минимум ${param} символов`;
        break;
      case 'maxLength':
        isValid = value.length <= param;
        message = isValid ? '' : `Максимум ${param} символов`;
        break;
      case 'required':
        isValid = value.trim().length > 0;
        message = isValid ? '' : 'Поле обязательно';
        break;
      case 'email':
        isValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
        message = isValid ? '' : 'Некорректный email';
        break;
      case 'pattern':
        isValid = new RegExp(param).test(value);
        message = isValid ? '' : 'Некорректный формат';
        break;
    }
    return { isValid, message };
  };
}

