CREATE DATABASE production_shop;
USE production_shop;

станки
CREATE TABLE machines (
    machine_id INT AUTO_INCREMENT PRIMARY KEY,
    machine_name VARCHAR(100) NOT NULL,
    machine_type VARCHAR(50),
    installation_date DATE,
    status VARCHAR(30) DEFAULT 'Работает'
);

 смены
CREATE TABLE shifts (
    shift_id INT AUTO_INCREMENT PRIMARY KEY,
    shift_name VARCHAR(50) NOT NULL,
    start_time TIME NOT NULL,
    end_time TIME NOT NULL
);

 сменные задания
CREATE TABLE shift_tasks (
    task_id INT AUTO_INCREMENT PRIMARY KEY,
    machine_id INT NOT NULL,
    shift_id INT NOT NULL,
    task_date DATE NOT NULL,
    product_name VARCHAR(100) NOT NULL,
    planned_quantity INT NOT NULL,
    FOREIGN KEY (machine_id) REFERENCES machines(machine_id),
    FOREIGN KEY (shift_id) REFERENCES shifts(shift_id)
);

выпускк деталей
CREATE TABLE production (
    production_id INT AUTO_INCREMENT PRIMARY KEY,
    task_id INT NOT NULL,
    produced_at DATETIME NOT NULL,
    quantity INT NOT NULL,
    good_quantity INT NOT NULL,
    defective_quantity INT NOT NULL,
    FOREIGN KEY (task_id) REFERENCES shift_tasks(task_id)
);

  брак
CREATE TABLE defects (
    defect_id INT AUTO_INCREMENT PRIMARY KEY,
    production_id INT NOT NULL,
    defect_type VARCHAR(100),
    defect_quantity INT NOT NULL,
    description TEXT,
    FOREIGN KEY (production_id) REFERENCES production(production_id)
);

расход сырья
CREATE TABLE material_consumption (
    consumption_id INT AUTO_INCREMENT PRIMARY KEY,
    task_id INT NOT NULL,
    material_name VARCHAR(100) NOT NULL,
    quantity DECIMAL(12,3) NOT NULL,
    unit VARCHAR(20),
    consumed_at DATETIME NOT NULL,
    FOREIGN KEY (task_id) REFERENCES shift_tasks(task_id)
);

события оборудования 
CREATE TABLE machine_events (
    event_id INT AUTO_INCREMENT PRIMARY KEY,
    machine_id INT NOT NULL,
    event_type VARCHAR(30) NOT NULL,
    start_time DATETIME NOT NULL,
    end_time DATETIME,
    description TEXT,
    FOREIGN KEY (machine_id) REFERENCES machines(machine_id)
);



