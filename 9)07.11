// Задание 01
function alignCardHeights(cardsContainer) {
  const cards = [...cardsContainer.querySelectorAll(".product-card")];
  const heights = cards.map(card => card.getBoundingClientRect().height);

  cards.forEach((card, index) => {
    if (heights[index] < 300) {
      card.style.height = "300px";
    }
  });
}

// Задание 02
async function processAnalytics(rawTransactions, filterCriteria) {
  let totalRevenue = 0;
  let totalTax = 0;
  const chunkSize = 1000;

  for (let i = 0; i < rawTransactions.length; i += chunkSize) {
    const chunk = rawTransactions.slice(i, i + chunkSize);

    for (const t of chunk) {
      if (t.amount > filterCriteria.min && t.status === "completed") {
        totalRevenue += t.amount;
        totalTax += t.amount * 0.2;
      }
    }

    if (i + chunkSize < rawTransactions.length) {
      if (globalThis.scheduler?.yield) {
        await scheduler.yield();
      } else {
        await new Promise(resolve => setTimeout(resolve, 0));
      }
    }
  }

  return { totalRevenue, totalTax };
}

// Задание 03
async function asyncPool(taskFactories, limit = 4) {
  if (!Array.isArray(taskFactories) || !Number.isInteger(limit) || limit < 1) {
    throw new TypeError("Invalid arguments");
  }

  const results = new Array(taskFactories.length);
  let currentIndex = 0;

  async function worker() {
    while (currentIndex < taskFactories.length) {
      const index = currentIndex++;

      try {
        results[index] = {
          status: "fulfilled",
          value: await taskFactories[index]()
        };
      } catch (error) {
        results[index] = {
          status: "rejected",
          reason: error
        };
      }
    }
  }

  await Promise.all(
    Array.from(
      { length: Math.min(limit, taskFactories.length) },
      () => worker()
    )
  );

  return results;
}

// Задание 04
const nodeMetadataCache = new WeakMap();

function attachComponentMetadata(domNode, metadata) {
  nodeMetadataCache.set(domNode, {
    ...metadata,
    attachedAt: Date.now()
  });
}

function getComponentMetadata(domNode) {
  return nodeMetadataCache.get(domNode);
}

// Задание 05
function pollServerStatus(onStatusUpdate) {
  const controller = new AbortController();
  let isAlive = true;

  async function loop() {
    while (isAlive) {
      try {
        const res = await fetch("/api/health", {
          signal: controller.signal
        });

        if (!res.ok) throw new Error("HTTP error");

        const data = await res.json();

        if (isAlive) onStatusUpdate(data);
      } catch (error) {
        if (error.name === "AbortError") break;
        console.error("Poll error", error);
      }

      if (isAlive) {
        await new Promise(resolve => setTimeout(resolve, 5000));
      }
    }
  }

  loop();

  return function unsubscribe() {
    isAlive = false;
    controller.abort();
  };
}

