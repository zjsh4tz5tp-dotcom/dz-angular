09.
function createPaginationButtons(pagesCount) {
  const buttons = [];

  for (let i = 1; i <= pagesCount; i++) {
    buttons.push(() => {
      console.log(`Переход на страницу: ${i}`);
    });
  }

  return buttons;
}

function createPaginationButtonsWithVar(pagesCount) {
  var buttons = [];

  for (var i = 1; i <= pagesCount; i++) {
    buttons.push((function (page) {
      return function () {
        console.log(`Переход на страницу: ${page}`);
      };
    })(i));
  }

  return buttons;
}

10.
const analyticsTracker = {
  prefix: "ANALYTICS_EVENT",

  sendEvent(eventName) {
    console.log(`[${this.prefix}]: ${eventName}`);
  }
};

document
  .getElementById("checkout-btn")
  .addEventListener(
    "click",
    analyticsTracker.sendEvent.bind(analyticsTracker)
  );

document
  .getElementById("checkout-btn")
  .addEventListener("click", event => {
    analyticsTracker.sendEvent(event.type);
  });

document
  .getElementById("checkout-btn")
  .addEventListener("click", function () {
    analyticsTracker.sendEvent.call(analyticsTracker, "checkout");
  });

11.
function getTopExpensiveProducts(products) {
  return [...products]
    .sort((a, b) => b.price - a.price)
    .slice(0, 3);
}

