function filterCatalog(items, criteria) {
  return items.filter(item =>
    (criteria.category === undefined || item.category === criteria.category) &&
    (criteria.maxPrice === undefined || item.price <= criteria.maxPrice) &&
    (!criteria.onlyInStock || item.inStock)
