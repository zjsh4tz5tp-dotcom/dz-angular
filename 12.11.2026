// Задание 01
function checkAuthAndNavigate(isAuthenticated, currentPath) {
  if (!isAuthenticated && currentPath !== "/login") {
    window.history.replaceState({}, "", "/login");
    renderLoginPage();
  }
}

// Задание 02
function mountHeader() {
  const header = document.getElementById("header");

  if (!header) return () => {};

  const handleResize = () => {
    const isMobile = window.innerWidth < 768;
    header.className = isMobile ? "header-mobile" : "header-desktop";
  };

  window.addEventListener("resize", handleResize);
  handleResize();

  return function unmount() {
    window.removeEventListener("resize", handleResize);
  };
}

// Задание 03
function ProductCard({ product, router }) {
  return `
    <div class="card">
      <h3>${product.title}</h3>
      <a href="/cart" data-route="/cart">В корзину</a>
    </div>
  `;
}

document.addEventListener("click", (event) => {
  const link = event.target.closest("a[data-route]");

  if (!link) return;

  event.preventDefault();
  router.navigate(link.dataset.route);
});

