  define: {
    __APP_VERSION__: JSON.stringify(packageJson.version)
  }
});

export function Footer() {
  return <footer>Версия: {__APP_VERSION__}</footer>;
}

07.
function resetAttemptsForActiveUsers(usersList) {
  return usersList
    .filter(user => user.isActive)
    .map(user => ({
      ...user,
      loginAttempts: 0
    }));
}

