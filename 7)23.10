10.
const http = require("node:http");
const fs = require("node:fs");
const WebSocket = require("ws");

const server = http.createServer();
const wss = new WebSocket.Server({ server });

wss.on("connection", socket => {
  socket.send(JSON.stringify({ type: "connected" }));
});

fs.watch("./test.js", eventType => {
  if (eventType !== "change") return;

  const message = JSON.stringify({ type: "reload" });

  for (const client of wss.clients) {
    if (client.readyState === WebSocket.OPEN) {
      client.send(message);
    }
  }
});

server.listen(3001);

11.
function deepFreeze(object, seen = new WeakSet()) {
  if (
    object === null ||
    (typeof object !== "object" && typeof object !== "function") ||
    seen.has(object)
  ) {
    return object;
  }

  seen.add(object);

  for (const key of Reflect.ownKeys(object)) {
    deepFreeze(object[key], seen);
  }

  return Object.freeze(object);
}

12.
function createCounter(initialValue = 0, step = 1) {
  let value = initialValue;

  return {
    inc() {
      value += step;
      return value;
    },

    dec() {
      value -= step;
      return value;
    },

    reset() {
      value = initialValue;
      return value;
    },

    get() {
      return value;
    }
  };
}

13.
function memoize(fn) {
  const cache = new Map();

  return function (...args) {
    const key = JSON.stringify(args);

    if (cache.has(key)) {
      return cache.get(key);
    }

    const result = fn.apply(this, args);
    cache.set(key, result);

    return result;
  };
}

14.
function createValidator(ruleName, param) {
  return function (value) {
    const text = String(value ?? "");

    switch (ruleName) {
      case "required":
        return {
          isValid: text.trim().length > 0,
          message: "Поле обязательно для заполнения"
        };

      case "minLength":
        return {
          isValid: text.length >= param,
          message: `Минимальная длина: ${param}`
        };

      case "maxLength":
        return {
          isValid: text.length <= param,
          message: `Максимальная длина: ${param}`
        };

      case "email":
        return {
          isValid: /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(text),
          message: "Некорректный email"
        };

      default:
        return {
          isValid: false,
          message: "Неизвестное правило проверки"
        };
    }
  };
}

