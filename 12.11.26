01.
function checkAuthAndNavigate(isAuthenticated, currentPath) {
  if (!isAuthenticated && currentPath !== "/login") {
    window.history.replaceState({}, "", "/login");
    renderLoginPage();
  }
}

02.
function mountHeader() {
  const header = document.getElementById("header");

  function updateHeader() {
    header.className = window.innerWidth < 768
      ? "header-mobile"
      : "header-desktop";
  }

  window.addEventListener("resize", updateHeader);
  updateHeader();

  return function unmountHeader() {
    window.removeEventListener("resize", updateHeader);
  };
}

03.
function ProductCard({ product }) {
  return `
    <div class="card">
      <h3>${product.title}</h3>
      <a href="/cart" data-route="/cart">В корзину</a>
    </div>
  `;
}

function mountProductCards(router) {
  function handleNavigation(event) {
    const link = event.target.closest("a[data-route]");

    if (!link) return;

    event.preventDefault();
    router.navigate(link.dataset.route);
  }

  document.addEventListener("click", handleNavigation);

  return function unmountProductCards() {
    document.removeEventListener("click", handleNavigation);
  };
}

