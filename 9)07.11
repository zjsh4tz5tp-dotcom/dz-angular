// Задание 13
const rowStyle = {
  padding: "8px",
  borderBottom: "1px solid #eee"
};

const rowOptions = {
  canSelect: true,
  canEdit: false
};

const Table = React.memo(function Table({ rows }) {
  const handleDelete = useCallback(id => {
    console.log("Delete", id);
  }, []);

  return (
    <div>
      {rows.map(row => (
        <TableRow
          key={row.id}
          data={row}
          style={rowStyle}
          options={rowOptions}
          onDelete={() => handleDelete(row.id)}
        />
      ))}
    </div>
  );
});

// Задание 14
function mergeUniquePosts(oldPosts, newPosts) {
  const seen = new Set(oldPosts.map(post => post.id));

  const uniquePosts = newPosts.filter(post => {
    if (seen.has(post.id)) return false;
    seen.add(post.id);
    return true;
  });

  return [...oldPosts, ...uniquePosts];
}

function appendNextPage(newPostsFromApi) {
  feedState = {
    ...feedState,
    posts: mergeUniquePosts(feedState.posts, newPostsFromApi)
  };
}

// Задание 15
function renderBadgeConfig(config = {}) {
  const color = config.color ?? "blue";
  const text = config.text ?? "Новинка";
  const icon = config.icon ?? "star";

  return `<span class="badge ${color}">${icon} ${text}</span>`;
}

