09. function createPaginationButtons(pagesCount) {
  const buttons = [];

  for (let i = 1; i <= pagesCount; i++) {
    buttons.push(() => {
      console.log(`Переход на страницу: ${i}`);
    });
  }

  return buttons;
}

function createPaginationButtonsWithVar(pagesCount) {
  const buttons = [];

  for (var i = 1; i <= pagesCount; i++) {
    buttons.push(
      ((page) => () => {
        console.log(`Переход на страницу: ${page}`);
      })(i)
    );
  }

  return buttons;
}

10. const analyticsTracker = {
  prefix: "ANALYTICS_EVENT",
  sendEvent(eventName) {
    console.log(`[${this.prefix}]: ${eventName}`);
  },
};

const button = document.getElementById("checkout-btn");

button.addEventListener(
  "click",
  analyticsTracker.sendEvent.bind(analyticsTracker)
);

button.addEventListener("click", (event) => {
  analyticsTracker.sendEvent(event.type);
});

const sendAnalyticsEvent =
  analyticsTracker.sendEvent.bind(analyticsTracker);

button.addEventListener("click", () => {
  sendAnalyticsEvent("checkout");
});

11. function getTopExpensiveProducts(products) {
  return [...products]
    .sort((a, b) => b.price - a.price)
    .slice(0, 3);
}

12. function mapIdsToTasks(ids) {
  return ids.map((id) => ({
    taskId: id,
    isDone: false,
  }));
}

