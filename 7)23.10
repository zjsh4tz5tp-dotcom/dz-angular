22.
function extractDomProps(allProps, customKeysArray) {
  const customKeys = new Set(customKeysArray);

  return Object.fromEntries(
    Object.entries(allProps).filter(([key]) => !customKeys.has(key))
  );
}

23.
function deepMerge(target, source) {
  if (
    source === null ||
    typeof source !== "object" ||
    Array.isArray(source)
  ) {
    return source;
  }

  const result = {
    ...(target && typeof target === "object" && !Array.isArray(target)
      ? target
      : {})
  };

  for (const key of Object.keys(source)) {
    const sourceValue = source[key];
    const targetValue = result[key];

    if (
      sourceValue !== null &&
      typeof sourceValue === "object" &&
      !Array.isArray(sourceValue)
    ) {
      result[key] = deepMerge(targetValue, sourceValue);
    } else {
      result[key] = Array.isArray(sourceValue)
        ? [...sourceValue]
        : sourceValue;
    }
  }

  return result;
}

24.
function normalizeEntities(array) {
  if (!Array.isArray(array)) {
    throw new TypeError("Входной параметр должен быть массивом");
  }

  return {
    byId: Object.fromEntries(
      array.map(item => [String(item.id), { ...item }])
    ),
    allIds: array.map(item => String(item.id))
  };
}

function patchEntityById(state, id, patch) {
  const key = String(id);
  const currentEntity = state.byId[key];

  if (!currentEntity) {
    return state;
  }

  return {
    ...state,
    byId: {
      ...state.byId,
      [key]: {
        ...currentEntity,
        ...patch
      }
    },
    allIds: state.allIds
  };
}

function removeEntityById(state, id) {
  const key = String(id);

  if (!Object.prototype.hasOwnProperty.call(state.byId, key)) {
    return state;
  }

  const { [key]: removed, ...remainingById } = state.byId;

  return {
    byId: remainingById,
    allIds: state.allIds.filter(itemId => itemId !== key)
  };
}

