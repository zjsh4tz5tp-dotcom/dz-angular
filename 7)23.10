01.
class ClientRouter {
  constructor(routes, root) {
    this.routes = routes;
    this.root = root;

    document.addEventListener("click", this.handleClick.bind(this));
    window.addEventListener("popstate", () => this.render());

    this.render();
  }

  handleClick(event) {
    const link = event.target.closest("a");

    if (!link || link.origin !== window.location.origin) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    if (link.target && link.target !== "_self") return;

    const path = link.pathname;

    if (!this.routes[path]) return;

    event.preventDefault();
    window.history.pushState({}, "", path);
    this.render();
  }

  render() {
    const page = this.routes[window.location.pathname];

    this.root.innerHTML = page ? page() : "<h1>404</h1>";
  }

  navigate(path) {
    if (!this.routes[path]) return;

    window.history.pushState({}, "", path);
    this.render();
  }
}

02.
function createVNode(type, props, ...children) {
  const normalizedChildren = children.length === 1
    ? children[0]
    : children;

  const { key = null, ...restProps } = props ?? {};

  return {
    type,
    props: {
      ...restProps,
      children: normalizedChildren
    },
    key
  };
}

03.
function shallowEqual(objA, objB) {
  if (Object.is(objA, objB)) return true;

  if (
    objA === null ||
    objB === null ||
    typeof objA !== "object" ||
    typeof objB !== "object"
  ) {
    return false;
  }

  const keysA = Object.keys(objA);
  const keysB = Object.keys(objB);

  if (keysA.length !== keysB.length) return false;

  for (const key of keysA) {
    if (
      !Object.prototype.hasOwnProperty.call(objB, key) ||
      !Object.is(objA[key], objB[key])
    ) {
      return false;
    }
  }

  return true;
}

04.
function Child({ count, onIncrement }) {
  return {
    count,
    increment: () => onIncrement()
  };
}

function Parent(initialCount = 0) {
  let count = initialCount;

  function increment() {
    count += 1;
    return render();
  }

  function render() {
    return Child({
      count,
      onIncrement: increment
    });
  }

  return {
    getCount: () => count,
    child: render()
  };
}

05.
function renderToHTML(vNode) {
  if (vNode === null || vNode === undefined || vNode === false || vNode === true) {
    return "";
  }

  if (typeof vNode === "string" || typeof vNode === "number") {
    return String(vNode)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  if (Array.isArray(vNode)) {
    return vNode.map(renderToHTML).join("");
  }

  const { type, props = {} } = vNode;
  const { children, ...attributes } = props;

  const attrs = Object.entries(attributes)
    .filter(([key, value]) =>
      value !== null &&
      value !== undefined &&
      value !== false &&
      !key.startsWith("on")
    )
    .map(([key, value]) => {
      const attrName = key === "className" ? "class" : key;

      if (value === true) return ` ${attrName}=""`;

      return ` ${attrName}="${String(value)
        .replace(/&/g, "&amp;")
        .replace(/"/g, "&quot;")}"`;
    })
    .join("");

  const voidElements = new Set([
    "area", "base", "br", "col", "embed", "hr",
    "img", "input", "link", "meta", "param",
    "source", "track", "wbr"
  ]);

  if (voidElements.has(type)) {
    return `<${type}${attrs}>`;
  }

  return `<${type}${attrs}>${renderToHTML(children)}</${type}>`;
}

06.
const fs = require("node:fs");
const path = require("node:path");

const packagePath = path.resolve(process.cwd(), "package.json");
const packageJson = JSON.parse(fs.readFileSync(packagePath, "utf8"));
const dependencies = packageJson.dependencies ?? {};

const invalidPackages = Object.entries(dependencies)
  .filter(([, version]) => /^[~^]/.test(version));

if (invalidPackages.length > 0) {
  console.error("Обнаружены зависимости с диапазонами версий:");

  for (const [name, version] of invalidPackages) {
    console.error(`${name}: ${version}`);
  }

  process.exit(1);
}

console.log("Все версии dependencies зафиксированы.");

